# Copiez ce fichier en .env pour le développement local (npm run dev),
# ou passez ces variables via `environment:` / `env_file:` dans docker-compose.yml.

# --- Serveur ---
PORT=3000
# Chaîne aléatoire longue, à changer impérativement en production
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING
SESSION_MAX_AGE_MS=28800000
# À définir si le service tourne derrière un reverse proxy (nginx, traefik...)
# avec TLS, pour que le cookie de session "secure" fonctionne. Ex: 1
#TRUST_PROXY=1

# --- IMAP (lecture du brouillon à envoyer) ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
# Liste de dossiers brouillons candidats, séparés par des virgules
IMAP_DRAFTS_FOLDERS=Drafts,INBOX.Drafts,[Gmail]/Drafts,Brouillons

# --- SMTP (envoi des emails) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true

# --- Cadence d'envoi ---
SEND_RATE_EMAILS_PER_MINUTE=10

# --- Upload des fichiers destinataires ---
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_ALLOWED_EXTENSIONS=.csv,.vcf

# --- Tracking (ouvertures / clics) ---
# URL publique par laquelle les destinataires accèdent au service
TRACKING_PUBLIC_BASE_URL=https://mailer.example.com

# --- Stockage ---
# Répertoire où la base SQLite est créée/lue. En Docker, pointez ceci sur
# un volume monté (voir docker-compose.yml).
DATA_DIR=/app/data
